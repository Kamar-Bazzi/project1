# Copy to .env.production on the deployment host and inject real values from
# the platform secret manager. Never commit .env.production.
NODE_ENV=production
POSTGRES_DB=medical_tracking
POSTGRES_USER=medical_app
POSTGRES_PASSWORD=generate-a-long-random-database-password
DATABASE_URL=postgresql://medical_app:url-encoded-password@database:5432/medical_tracking?schema=public

JWT_SECRET=generate-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=caretrack-api
JWT_AUDIENCE=caretrack-web
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_REQUIRE_VERIFIED_EMAIL=true
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_WARNING_THRESHOLD=3
LOGIN_LOCK_THRESHOLD=10
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_AUDIT_COALESCE_SECONDS=30
APP_PUBLIC_URL=https://medical.example.com
COOKIE_SECURE=true

PORT=3000
CORS_ORIGIN=https://medical.example.com
TRUST_PROXY=true
SWAGGER_ENABLED=true
HTTP_LOGGING=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=medical-app
SMTP_PASSWORD=inject-from-secret-manager
SMTP_FROM=Medical Tracking <no-reply@medical.example.com>

WEB_PUSH_SUBJECT=mailto:security@medical.example.com
WEB_PUSH_PUBLIC_KEY=generate-with-the-web-push-cli
WEB_PUSH_PRIVATE_KEY=inject-from-secret-manager
# Optional: comma-separated HTTPS origins for approved custom push services.
WEB_PUSH_ALLOWED_ORIGINS=

# Optional SMS delivery. Use MOCK only for staging/local verification; set a
# real provider only after configuring credentials in the secret manager and
# provider-specific retry/error handling.
SMS_PROVIDER=MOCK
SMS_FROM=CareTrack
SMS_API_KEY=inject-from-secret-manager-when-real-provider-is-enabled
SMS_API_SECRET=inject-from-secret-manager-when-real-provider-is-enabled

# Wearable providers. MOCK remains the only connectable demo provider in this
# web deployment. Fitbit/Garmin require OAuth apps and secure token storage;
# HealthKit/Health Connect require native mobile companion apps.
WEARABLE_ENABLED_PROVIDERS=MOCK
FITBIT_CLIENT_ID=configure-when-fitbit-oauth-is-enabled
FITBIT_CLIENT_SECRET=inject-from-secret-manager-when-fitbit-is-enabled
FITBIT_REDIRECT_URI=https://medical.example.com/api/v1/wearables/fitbit/callback
GARMIN_CLIENT_ID=configure-when-garmin-oauth-is-enabled
GARMIN_CLIENT_SECRET=inject-from-secret-manager-when-garmin-is-enabled
GARMIN_REDIRECT_URI=https://medical.example.com/api/v1/wearables/garmin/callback
HEALTH_CONNECT_ANDROID_PACKAGE=configure-when-android-companion-app-exists
HEALTHKIT_IOS_BUNDLE_ID=configure-when-ios-companion-app-exists

MEDICATION_REMINDER_LEAD_MINUTES=15
MEDICATION_OVERDUE_GRACE_MINUTES=30
APPOINTMENT_REMINDER_MAX_LOOKAHEAD_HOURS=168
NOTIFICATION_DISPATCH_BATCH_SIZE=100

# Scheduled UTC database retention. Confirm these durations against the
# operator's legal, clinical-record, and incident-response requirements.
AUDIT_LOG_RETENTION_DAYS=365
NOTIFICATION_RETENTION_DAYS=180
HEALTH_METRIC_RETENTION_DAYS=2555
EXPIRED_SECURITY_TOKEN_RETENTION_DAYS=7
DATA_RETENTION_BATCH_SIZE=1000
DATA_RETENTION_MAX_BATCHES=20

# Private API-only document storage. This path is mounted from the
# document-data volume and must never be served directly by the web container.
DOCUMENT_STORAGE_PATH=/var/lib/caretrack/documents
DOCUMENT_MAX_FILES_PER_PATIENT=500
DOCUMENT_MAX_BYTES_PER_PATIENT=1073741824
DOCUMENT_MAX_TOTAL_BYTES=107374182400

# Required, fail-closed malware scanning for document uploads. Clamd is
# reachable only over the private backend network; never publish port 3310.
DOCUMENT_MALWARE_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
