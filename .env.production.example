# Copy to .env.production on the deployment host and inject real values from
# the platform secret manager. Never commit .env.production.
NODE_ENV=production
POSTGRES_DB=medical_tracking
POSTGRES_USER=medical_app
POSTGRES_PASSWORD=generate-a-long-random-database-password
DATABASE_URL=postgresql://medical_app:url-encoded-password@database:5432/medical_tracking?schema=public

JWT_SECRET=generate-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=caretrack-api
JWT_AUDIENCE=caretrack-web
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_REQUIRE_VERIFIED_EMAIL=true
APP_PUBLIC_URL=https://medical.example.com
COOKIE_SECURE=true

PORT=3000
CORS_ORIGIN=https://medical.example.com
TRUST_PROXY=true
SWAGGER_ENABLED=true
HTTP_LOGGING=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=medical-app
SMTP_PASSWORD=inject-from-secret-manager
SMTP_FROM=Medical Tracking <no-reply@medical.example.com>

WEB_PUSH_SUBJECT=mailto:security@medical.example.com
WEB_PUSH_PUBLIC_KEY=generate-with-the-web-push-cli
WEB_PUSH_PRIVATE_KEY=inject-from-secret-manager
# Optional: comma-separated HTTPS origins for approved custom push services.
WEB_PUSH_ALLOWED_ORIGINS=

MEDICATION_REMINDER_LEAD_MINUTES=15
MEDICATION_OVERDUE_GRACE_MINUTES=30
APPOINTMENT_REMINDER_MAX_LOOKAHEAD_HOURS=168
NOTIFICATION_DISPATCH_BATCH_SIZE=100

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
