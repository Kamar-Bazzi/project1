generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MedicationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MedicationLogStatus {
  PENDING
  TAKEN
  MISSED
  SKIPPED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum DoctorNoteCategory {
  GENERAL
  CARE_PLAN
  MEDICATION_REVIEW
  FOLLOW_UP
}

enum HealthGoalMetric {
  WEIGHT
  DAILY_STEPS
  DAILY_ACTIVITY_MINUTES
  HEART_RATE
  BLOOD_PRESSURE
  BLOOD_GLUCOSE
  OXYGEN_SATURATION
  SLEEP_DURATION
  MEDICATION_ADHERENCE
}

enum HealthGoalDirection {
  AT_LEAST
  AT_MOST
  BETWEEN
}

enum HealthGoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  CANCELLED
}

enum HealthGoalProgressSource {
  MANUAL
  AUTOMATIC
}

enum EmergencyEventStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

enum MeasurementType {
  BLOOD_PRESSURE
  TEMPERATURE
  WEIGHT
  BLOOD_GLUCOSE
  HEART_RATE
  OXYGEN_SATURATION
}

enum WearableProvider {
  MOCK
  HEALTH_CONNECT
  HEALTHKIT
  FITBIT
  GARMIN
  SAMSUNG
  OTHER
}

enum HealthMetricType {
  HEART_RATE
  RESTING_HEART_RATE
  STEPS
  DISTANCE
  CALORIES
  SLEEP_DURATION
  BLOOD_OXYGEN
  RESPIRATORY_RATE
  BODY_TEMPERATURE
  WEIGHT
}

enum HealthMetricSource {
  MOCK
  HEALTH_CONNECT
  HEALTHKIT
  FITBIT
  GARMIN
  SAMSUNG
  MANUAL
  OTHER
}

enum HealthAlertSeverity {
  INFO
  WARNING
  URGENT
}

enum HealthAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum OneTimeTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum NotificationType {
  MEDICATION_REMINDER
  MEDICATION_OVERDUE
  APPOINTMENT_REMINDER
  HEALTH_ALERT
  EMERGENCY_ALERT
  SECURITY_ALERT
  SYSTEM
}

enum NotificationChannelType {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

model User {
  id                String        @id @default(uuid())
  name              String
  email             String        @unique
  passwordHash      String
  role              UserRole      @default(PATIENT)
  accountStatus     AccountStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?

  patient                Patient?
  doctor                 Doctor?
  auditLogs              AuditLog[]
  authSessions           AuthSession[]
  oneTimeTokens          OneTimeToken[]
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, accountStatus])
}

model Patient {
  id               String    @id @default(uuid())
  userId           String    @unique
  dateOfBirth      DateTime? @db.Date
  phoneNumber      String?
  emergencyContact String?
  timeZone         String?

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  medications        Medication[]
  measurements       Measurement[]
  appointments       Appointment[]
  wearableDevices    WearableDevice[]
  healthMetrics      HealthMetric[]
  emergencyContacts  EmergencyContact[]
  healthAlerts       HealthAlert[]
  alertRules         AlertRule[]
  doctorAccessGrants DoctorPatientAccess[]
  doctorNotes        DoctorNote[]
  followUps          PatientFollowUp[]
  healthGoals        HealthGoal[]
  emergencyEvents    EmergencyEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Doctor {
  id             String  @id @default(uuid())
  userId         String  @unique
  specialization String?
  licenseNumber  String? @unique

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  patientAccessGrants DoctorPatientAccess[]
  doctorNotes         DoctorNote[]
  followUps           PatientFollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medication {
  id           String           @id @default(uuid())
  patientId    String
  name         String
  dosage       String
  instructions String?
  startDate    DateTime
  endDate      DateTime?
  status       MedicationStatus @default(ACTIVE)

  patient   Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  schedules MedicationSchedule[]
  logs      MedicationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

model MedicationSchedule {
  id            String @id @default(uuid())
  medicationId  String
  scheduledTime String
  frequency     String

  medication Medication      @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  logs       MedicationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([medicationId, scheduledTime])
  @@index([medicationId])
}

model MedicationLog {
  id           String              @id @default(uuid())
  medicationId String
  scheduleId   String?
  scheduleDate DateTime?           @db.Date
  scheduledFor DateTime
  takenAt      DateTime?
  status       MedicationLogStatus @default(PENDING)

  medication    Medication          @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  schedule      MedicationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, scheduleDate])
  @@index([medicationId])
  @@index([scheduleId])
}

model Measurement {
  id             String          @id @default(uuid())
  patientId      String
  type           MeasurementType
  value          Float
  secondaryValue Float?
  unit           String
  measuredAt     DateTime

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

model WearableDevice {
  id               String           @id @default(uuid())
  patientId        String
  provider         WearableProvider
  deviceName       String
  externalDeviceId String?
  connectedAt      DateTime         @default(now())
  lastSyncAt       DateTime?
  active           Boolean          @default(true)

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  healthMetrics HealthMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientId, provider, externalDeviceId])
  @@index([patientId])
  @@index([provider])
  @@index([patientId, active])
}

model HealthMetric {
  id               String             @id @default(uuid())
  patientId        String
  wearableDeviceId String?
  metricType       HealthMetricType
  value            Float
  secondaryValue   Float?
  unit             String
  measuredAt       DateTime
  source           HealthMetricSource
  externalRecordId String?
  deduplicationKey String
  metadata         Json?

  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  wearableDevice WearableDevice? @relation(fields: [wearableDeviceId], references: [id], onDelete: SetNull)
  alerts         HealthAlert[]

  createdAt DateTime @default(now())

  @@unique([patientId, deduplicationKey])
  @@index([patientId])
  @@index([metricType])
  @@index([measuredAt])
  @@index([wearableDeviceId])
  @@index([patientId, metricType, measuredAt])
}

model EmergencyContact {
  id           String  @id @default(uuid())
  patientId    String
  name         String
  relationship String
  phone        String
  email        String?
  active       Boolean @default(true)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([patientId, active])
}

model AlertRule {
  id                          String              @id @default(uuid())
  patientId                   String
  metricType                  HealthMetricType
  enabled                     Boolean             @default(true)
  minimumValue                Float?
  maximumValue                Float?
  consecutiveReadingsRequired Int                 @default(3)
  severity                    HealthAlertSeverity @default(WARNING)
  notifyEmergencyContacts     Boolean             @default(false)

  patient Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  alerts  HealthAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientId, metricType])
  @@index([patientId])
  @@index([patientId, enabled])
}

model HealthAlert {
  id             String              @id @default(uuid())
  patientId      String
  metricType     HealthMetricType
  severity       HealthAlertSeverity
  message        String
  metricId       String?
  alertRuleId    String?
  status         HealthAlertStatus   @default(ACTIVE)
  detectedAt     DateTime            @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  metric        HealthMetric?  @relation(fields: [metricId], references: [id], onDelete: SetNull)
  alertRule     AlertRule?     @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([alertRuleId, metricId])
  @@index([patientId])
  @@index([metricType])
  @@index([metricId])
  @@index([alertRuleId])
  @@index([patientId, status, detectedAt])
}

model DoctorPatientAccess {
  id        String    @id @default(uuid())
  doctorId  String
  patientId String
  active    Boolean   @default(true)
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, patientId])
  @@index([doctorId, active])
  @@index([patientId, active])
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  appointmentDate DateTime
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?

  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorNotes   DoctorNote[]
  followUps     PatientFollowUp[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([patientId, status, appointmentDate])
  @@index([doctorId, status, appointmentDate])
}

model DoctorNote {
  id            String             @id @default(uuid())
  patientId     String
  doctorId      String
  appointmentId String?
  title         String
  content       String
  category      DoctorNoteCategory @default(GENERAL)

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
  @@index([doctorId, patientId, createdAt])
  @@index([appointmentId])
}

model PatientFollowUp {
  id              String    @id @default(uuid())
  patientId       String
  doctorId        String
  appointmentId   String?
  summary         String
  recommendations String?
  occurredAt      DateTime
  followUpAt      DateTime?

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([patientId, occurredAt])
  @@index([doctorId, patientId, occurredAt])
  @@index([appointmentId])
}

model HealthGoal {
  id                   String              @id @default(uuid())
  patientId            String
  title                String
  metric               HealthGoalMetric
  direction            HealthGoalDirection
  targetValue          Float
  targetSecondaryValue Float?
  unit                 String
  startDate            DateTime
  targetDate           DateTime?
  status               HealthGoalStatus    @default(ACTIVE)

  patient  Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  progress HealthGoalProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, status, targetDate])
  @@index([patientId, metric, createdAt])
}

model HealthGoalProgress {
  id             String                   @id @default(uuid())
  healthGoalId   String
  value          Float
  secondaryValue Float?
  source         HealthGoalProgressSource @default(MANUAL)
  note           String?
  recordedAt     DateTime

  healthGoal HealthGoal @relation(fields: [healthGoalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([healthGoalId, recordedAt])
}

model EmergencyEvent {
  id          String               @id @default(uuid())
  patientId   String
  status      EmergencyEventStatus @default(ACTIVE)
  note        String?
  latitude    Float?
  longitude   Float?
  triggeredAt DateTime             @default(now())
  resolvedAt  DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, status, triggeredAt])
}

model AuditLog {
  id        String  @id @default(uuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action, createdAt])
  @@index([ipAddress, createdAt])
}

model AuthSession {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdByIp String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model OneTimeToken {
  id         String              @id @default(uuid())
  userId     String
  purpose    OneTimeTokenPurpose
  tokenHash  String              @unique
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

model Notification {
  id               String           @id @default(uuid())
  userId           String
  type             NotificationType
  title            String
  message          String
  deduplicationKey String           @unique
  medicationLogId  String?
  healthAlertId    String?
  appointmentId    String?
  readAt           DateTime?

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicationLog MedicationLog?         @relation(fields: [medicationLogId], references: [id], onDelete: Cascade)
  healthAlert   HealthAlert?           @relation(fields: [healthAlertId], references: [id], onDelete: Cascade)
  appointment   Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  deliveries    NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, readAt, createdAt])
  @@index([medicationLogId])
  @@index([healthAlertId])
  @@index([appointmentId])
}

model NotificationPreference {
  id                       String  @id @default(uuid())
  userId                   String  @unique
  inAppEnabled             Boolean @default(true)
  emailEnabled             Boolean @default(true)
  pushEnabled              Boolean @default(true)
  medicationReminders      Boolean @default(true)
  appointmentReminders     Boolean @default(true)
  healthAlerts             Boolean @default(true)
  emergencyContactAlerts   Boolean @default(true)
  securityAlerts           Boolean @default(true)
  appointmentReminderHours Int     @default(24)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationDelivery {
  id                String                     @id @default(uuid())
  notificationId    String
  channel           NotificationChannelType
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  providerMessageId String?
  errorCode         String?
  lastAttemptAt     DateTime?
  sentAt            DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationId, channel])
  @@index([status, createdAt])
}

model PushSubscription {
  id             String    @id @default(uuid())
  userId         String
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  revokedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt])
}
