DATABASE_URL="postgresql://postgres:change-me@localhost:5432/medical_tracking?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_ISSUER="caretrack-api"
JWT_AUDIENCE="caretrack-web"
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_REQUIRE_VERIFIED_EMAIL=false
APP_PUBLIC_URL="http://localhost:5173"
COOKIE_SECURE=false
PORT=3000
CORS_ORIGIN="http://localhost:5173"
TRUST_PROXY=false
SWAGGER_ENABLED=true
HTTP_LOGGING=false

# SMTP and web-push providers. Blank values keep outbound delivery disabled in
# local development; inject real credentials outside source control.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Optional comma-separated HTTPS origins for additional self-hosted push services.
WEB_PUSH_ALLOWED_ORIGINS=

MEDICATION_REMINDER_LEAD_MINUTES=15
MEDICATION_OVERDUE_GRACE_MINUTES=30
APPOINTMENT_REMINDER_MAX_LOOKAHEAD_HOURS=168
NOTIFICATION_DISPATCH_BATCH_SIZE=100
