diff --git a/.env.production.example b/.env.production.example
index 405f092ebc95384ef1c3f99817afe5916328ecf0..839674560f5ed0c16c5ee080bfa74d2f962a412e 100644
--- a/.env.production.example
+++ b/.env.production.example
@@ -14,6 +14,11 @@ REFRESH_TOKEN_TTL_DAYS=30
 PASSWORD_RESET_TTL_MINUTES=30
 EMAIL_VERIFICATION_TTL_HOURS=24
 AUTH_REQUIRE_VERIFIED_EMAIL=true
+LOGIN_FAILURE_WINDOW_MINUTES=15
+LOGIN_WARNING_THRESHOLD=3
+LOGIN_LOCK_THRESHOLD=10
+LOGIN_LOCK_MINUTES=15
+RATE_LIMIT_AUDIT_COALESCE_SECONDS=30
 APP_PUBLIC_URL=https://medical.example.com
 COOKIE_SECURE=true
 
@@ -42,5 +47,28 @@ MEDICATION_OVERDUE_GRACE_MINUTES=30
 APPOINTMENT_REMINDER_MAX_LOOKAHEAD_HOURS=168
 NOTIFICATION_DISPATCH_BATCH_SIZE=100
 
+# Scheduled UTC database retention. Confirm these durations against the
+# operator's legal, clinical-record, and incident-response requirements.
+AUDIT_LOG_RETENTION_DAYS=365
+NOTIFICATION_RETENTION_DAYS=180
+HEALTH_METRIC_RETENTION_DAYS=2555
+EXPIRED_SECURITY_TOKEN_RETENTION_DAYS=7
+DATA_RETENTION_BATCH_SIZE=1000
+DATA_RETENTION_MAX_BATCHES=20
+
+# Private API-only document storage. This path is mounted from the
+# document-data volume and must never be served directly by the web container.
+DOCUMENT_STORAGE_PATH=/var/lib/caretrack/documents
+DOCUMENT_MAX_FILES_PER_PATIENT=500
+DOCUMENT_MAX_BYTES_PER_PATIENT=1073741824
+DOCUMENT_MAX_TOTAL_BYTES=107374182400
+
+# Required, fail-closed malware scanning for document uploads. Clamd is
+# reachable only over the private backend network; never publish port 3310.
+DOCUMENT_MALWARE_SCAN_REQUIRED=true
+CLAMAV_HOST=clamav
+CLAMAV_PORT=3310
+CLAMAV_TIMEOUT_MS=15000
+
 BACKUP_INTERVAL_SECONDS=86400
 BACKUP_RETENTION_DAYS=30
