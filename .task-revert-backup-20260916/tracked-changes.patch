+    if (outcomes.every((outcome) => outcome === 'DELIVERED')) {
+      return 'DELIVERED';
+    }
+    if (outcomes.every((outcome) => outcome === 'NOT_REQUESTED')) {
+      return 'NOT_REQUESTED';
+    }
