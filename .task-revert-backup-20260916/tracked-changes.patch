+            recipients: [contact.email],
+            subject: input.subject,
+            text: input.text,
+          })
+        : { outcome: 'NOT_CONFIGURED' as const };
+      const status =
+        result.outcome === 'DELIVERED'
+          ? NotificationDeliveryStatus.SENT
